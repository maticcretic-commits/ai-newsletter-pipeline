# Copy this file to .env (never commit the real one) and fill in your values.
# These variables are read by the workflow via $env in expression fields.

# Comma-separated RSS feed URLs to monitor. The workflow reads these
# when you configure RSS Feed nodes (duplicate the node per feed).
RSS_FEEDS=https://www.technologyreview.com/feed/,https://www.theverge.com/rss/index.xml

# OpenAI model used by both AI nodes. Any chat model works.
OPENAI_MODEL=gpt-4o-mini

# Newsletter identity and delivery
NEWSLETTER_FROM=The AI Brief
NEWSLETTER_TO=you@example.com

# Optional: schedule in your own words (the workflow's Schedule Trigger
# node also exposes this; keep both in sync).
NEWSLETTER_SCHEDULE=every Monday 9:00 AM

# Optional: switch "gmail" to "smtp" if you send through a mail relay.
MAIL_PROVIDER=gmail
